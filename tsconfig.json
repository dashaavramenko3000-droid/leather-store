{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "./static/js",
    "rootDir": "./static/ts",
    "lib": ["DOM", "ES2020"]
  },
  "include": ["static/ts/**/*.ts"]
}